    },
    "size": {
      "touch": { "$value": "2.75rem", "$type": "dimension" },
      "sheet-max": { "$value": "36rem", "$type": "dimension" }
    },
    "duration": {
      "fade": { "$value": "200ms", "$type": "duration" },
      "hover": { "$value": "150ms", "$type": "duration" },
      "none": { "$value": "0ms", "$type": "duration" }
    },
    "motion": {
      "seal-rotate": { "$value": "-2deg" }
    }
  },
  "semantic": {
    "color": {
      "background": { "$value": "{primitive.color.paper}", "$type": "color" },
      "foreground": { "$value": "{primitive.color.ink}", "$type": "color" },
