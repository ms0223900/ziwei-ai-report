{
  "$schema": "https://design-tokens.org/schema.json",
  "_meta": {
    "name": "ziwei-ink-paper",
    "theme": "墨箋夜讀",
    "version": "1.0.0",
    "source": "docs/design-brief.md",
    "darkMode": false
  },
  "primitive": {
    "color": {
      "paper": { "$value": "#E8E2D4", "$type": "color" },
      "sheet": { "$value": "#F7F4EC", "$type": "color" },
      "ink": { "$value": "#1E2430", "$type": "color" },
      "ink-soft": { "$value": "#5C6573", "$type": "color" },
      "seal": { "$value": "#8E1F2F", "$type": "color" },
      "seal-deep": { "$value": "#721926", "$type": "color" },
      "seal-deeper": { "$value": "#5C1420", "$type": "color" },
      "night": { "$value": "#2A3344", "$type": "color" },
      "night-bar": { "$value": "#3D4758", "$type": "color" },
      "line": { "$value": "#C9C2B3", "$type": "color" },
      "ok": { "$value": "#2F6F4E", "$type": "color" },
      "warn": { "$value": "#8A5A12", "$type": "color" }
    },
    "spacing": {
      "0": { "$value": "0", "$type": "dimension" },
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
