      "10": { "$value": "2.5rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" }
    },
    "fontFamily": {
      "heading": { "$value": "\"Noto Serif TC\", serif", "$type": "fontFamily" },
      "body": { "$value": "\"Noto Sans TC\", sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "\"IBM Plex Mono\", ui-monospace, monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "label": { "$value": "0.8125rem", "$type": "dimension" },
      "label-lg": { "$value": "0.875rem", "$type": "dimension" },
      "body": { "$value": "1.0625rem", "$type": "dimension" },
      "button": { "$value": "1.0625rem", "$type": "dimension" },
      "display": { "$value": "1.875rem", "$type": "dimension" }
