      "ink": { "$value": "{primitive.color.ink}", "$type": "color" },
      "ink-soft": { "$value": "{primitive.color.ink-soft}", "$type": "color" },
      "seal": { "$value": "{primitive.color.seal}", "$type": "color" },
      "night": { "$value": "{primitive.color.night}", "$type": "color" },
      "line": { "$value": "{primitive.color.line}", "$type": "color" },
      "primary": { "$value": "{primitive.color.seal}", "$type": "color" },
      "primary-hover": { "$value": "{primitive.color.seal-deep}", "$type": "color" },
      "primary-active": { "$value": "{primitive.color.seal-deeper}", "$type": "color" },
      "primary-foreground": { "$value": "{primitive.color.sheet}", "$type": "color" },
      "muted-foreground": { "$value": "{primitive.color.ink-soft}", "$type": "color" },
      "border": { "$value": "{primitive.color.line}", "$type": "color" },
      "ring": { "$value": "{primitive.color.seal}", "$type": "color" },
      "ok": { "$value": "{primitive.color.ok}", "$type": "color" },
      "warn": { "$value": "{primitive.color.warn}", "$type": "color" },
      "on-night": { "$value": "{primitive.color.sheet}", "$type": "color" }
    },
    "spacing": {
      "page-x": { "$value": "{primitive.spacing.5}", "$type": "dimension" },
      "page-x-lg": { "$value": "{primitive.spacing.6}", "$type": "dimension" },
      "section": { "$value": "{primitive.spacing.8}", "$type": "dimension" },
      "component": { "$value": "{primitive.spacing.4}", "$type": "dimension" }
    },
    "fontFamily": {
      "heading": { "$value": "{primitive.fontFamily.heading}", "$type": "fontFamily" },
      "body": { "$value": "{primitive.fontFamily.body}", "$type": "fontFamily" },
      "mono": { "$value": "{primitive.fontFamily.mono}", "$type": "fontFamily" }
    }
  },
  "component": {
    "button": {
      "bg": { "$value": "{semantic.color.primary}", "$type": "color" },
      "fg": { "$value": "{semantic.color.primary-foreground}", "$type": "color" },
      "hover-bg": { "$value": "{semantic.color.primary-hover}", "$type": "color" },
      "active-bg": { "$value": "{semantic.color.primary-active}", "$type": "color" },
      "padding-x": { "$value": "{primitive.spacing.5}", "$type": "dimension" },
      "padding-y": { "$value": "{primitive.spacing.3}", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.control}", "$type": "dimension" },
      "font-size": { "$value": "{primitive.fontSize.button}", "$type": "dimension" },
      "font-weight": { "$value": "{primitive.fontWeight.medium}", "$type": "fontWeight" },
      "min-height": { "$value": "{primitive.size.touch}", "$type": "dimension" }
    },
    "input": {
      "bg": { "$value": "{semantic.color.sheet}", "$type": "color" },
      "fg": { "$value": "{semantic.color.ink}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "focus-ring": { "$value": "{semantic.color.ring}", "$type": "color" },
      "error-border": { "$value": "{semantic.color.warn}", "$type": "color" },
      "error-fg": { "$value": "{semantic.color.warn}", "$type": "color" },
      "padding-x": { "$value": "{primitive.spacing.3}", "$type": "dimension" },
      "padding-y": { "$value": "{primitive.spacing.2}", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.control}", "$type": "dimension" },
      "font-size": { "$value": "{primitive.fontSize.body}", "$type": "dimension" }
