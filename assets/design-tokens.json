    "locked": {
      "bg": { "$value": "{semantic.color.night}", "$type": "color" },
      "fg": { "$value": "{semantic.color.on-night}", "$type": "color" },
      "bar": { "$value": "{primitive.color.night-bar}", "$type": "color" }
    }
