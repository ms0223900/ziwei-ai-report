# 注意！ 不要修改此份 .env.example 檔案，這是範例檔案，請「複製此檔案」並「修改」為 .env.local 檔案。

# ── Supabase（本版：service_role 後端寫入；anon 留位給單元 2）──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI（預設 mock，課程可零 key 跑主流程）──
AI_PROVIDER=mock
MOCK_AI_MODE=valid
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_FALLBACK_MODEL=

# ── 綠界 ECPay（單元 4，本版不使用）──
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_ENV=stage
APP_BASE_URL=
